@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(gnuradio4 CONFIG)
find_dependency(gnuradio4Library CONFIG)
if(NOT EMSCRIPTEN)
  find_dependency(httplib CONFIG)
  find_dependency(OpenSSL COMPONENTS Crypto)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/gnuradio4StudioBlocksTargets.cmake")

check_required_components(gnuradio4StudioBlocks)
