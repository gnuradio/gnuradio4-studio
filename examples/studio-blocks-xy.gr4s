{
  "format": "gr4-studio.graph",
  "version": 1,
  "metadata": {
    "name": "studio-blocks-xy.gr4s",
    "description": "Two nearly commensurate tones form a slowly changing 3:2 Lissajous curve. The same samples are shown as lines, points, and two time traces.",
    "schedulerId": "gr::scheduler::SimpleMulti",
    "application": {
      "mode": "in_app",
      "renderer": "react",
      "title": "Lissajous"
    },
    "studio": {
      "panels": [
        {
          "id": "controls",
          "kind": "control",
          "title": "Controls",
          "visible": true,
          "previewOnCanvas": false,
          "widgets": [
            {
              "id": "y-tone_frequency",
              "kind": "parameter",
              "binding": {
                "kind": "parameter",
                "nodeId": "y",
                "parameterName": "tone_frequency"
              },
              "label": "Y frequency (Hz)",
              "inputKind": "slider",
              "slider": {
                "min": 149,
                "max": 151,
                "step": 0.01
              },
              "mode": "immediate"
            },
            {
              "id": "y-phase",
              "kind": "parameter",
              "binding": {
                "kind": "parameter",
                "nodeId": "y",
                "parameterName": "phase"
              },
              "label": "Y phase (rad)",
              "inputKind": "slider",
              "slider": {
                "min": 0,
                "max": 6.28,
                "step": 0.05
              },
              "mode": "immediate"
            }
          ]
        },
        {
          "id": "line",
          "nodeId": "line",
          "kind": "series2d",
          "title": "XY trace",
          "visible": true,
          "previewOnCanvas": false,
          "plotStyle": {
            "assignmentMode": "byIndex",
            "palette": {
              "kind": "custom",
              "colors": [
                "#22d3ee",
                "#fb923c",
                "#a78bfa",
                "#4ade80"
              ]
            }
          }
        },
        {
          "id": "scatter",
          "nodeId": "scatter",
          "kind": "series2d",
          "title": "XY points",
          "visible": true,
          "previewOnCanvas": false,
          "plotStyle": {
            "assignmentMode": "byIndex",
            "palette": {
              "kind": "custom",
              "colors": [
                "#a78bfa",
                "#4ade80",
                "#22d3ee",
                "#fb923c"
              ]
            }
          }
        },
        {
          "id": "time",
          "nodeId": "time",
          "kind": "series",
          "title": "X and Y",
          "visible": true,
          "previewOnCanvas": false,
          "plotStyle": {
            "assignmentMode": "byIndex",
            "palette": {
              "kind": "custom",
              "colors": [
                "#22d3ee",
                "#fb923c",
                "#a78bfa",
                "#4ade80"
              ]
            }
          }
        }
      ],
      "variables": [
        {
          "id": "sample_rate",
          "name": "sample_rate",
          "binding": {
            "kind": "literal",
            "value": 8192
          }
        }
      ],
      "layout": {
        "version": 2,
        "root": {
          "kind": "split",
          "direction": "column",
          "children": [
            {
              "kind": "pane",
              "panelId": "controls"
            },
            {
              "kind": "split",
              "direction": "column",
              "children": [
                {
                  "kind": "split",
                  "direction": "row",
                  "children": [
                    {
                      "kind": "pane",
                      "panelId": "line"
                    },
                    {
                      "kind": "pane",
                      "panelId": "scatter"
                    }
                  ]
                },
                {
                  "kind": "pane",
                  "panelId": "time"
                }
              ],
              "sizes": [
                74,
                26
              ]
            }
          ],
          "sizes": [
            18,
            82
          ]
        },
        "activePanelId": "controls"
      }
    }
  },
  "graph": {
    "nodes": [
      {
        "id": "clock",
        "blockType": "gr::blocks::basic::ClockSource",
        "title": "Sample clock",
        "executionMode": "active",
        "rotation": 0,
        "position": {
          "x": 0,
          "y": 0
        },
        "parameters": {
          "sample_rate": {
            "kind": "expression",
            "expr": "sample_rate"
          },
          "chunk_size": {
            "kind": "literal",
            "value": "256"
          },
          "n_samples_max": {
            "kind": "literal",
            "value": "0"
          }
        }
      },
      {
        "id": "x",
        "blockType": "gr::blocks::basic::SignalGenerator<float32>",
        "title": "X",
        "executionMode": "active",
        "rotation": 0,
        "position": {
          "x": 260,
          "y": 0
        },
        "parameters": {
          "sample_rate": {
            "kind": "expression",
