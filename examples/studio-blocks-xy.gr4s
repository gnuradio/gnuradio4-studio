          },
          "chunk_size": {
            "kind": "literal",
            "value": "256"
          },
          "signal_type": {
            "kind": "literal",
            "value": "Sin"
          },
          "tone_frequency": {
            "kind": "literal",
            "value": "100"
          },
          "amplitude": {
            "kind": "literal",
            "value": "0.85"
          },
          "offset": {
            "kind": "literal",
            "value": "0"
          },
          "phase": {
            "kind": "literal",
            "value": "0"
          },
          "seed": {
            "kind": "literal",
            "value": "0"
          }
        }
      },
      {
        "id": "y",
        "blockType": "gr::blocks::basic::SignalGenerator<float32>",
        "title": "Y",
        "executionMode": "active",
        "rotation": 0,
        "position": {
          "x": 260,
          "y": 220
        },
        "parameters": {
          "sample_rate": {
            "kind": "expression",
            "expr": "sample_rate"
          },
          "chunk_size": {
            "kind": "literal",
            "value": "256"
          },
          "signal_type": {
            "kind": "literal",
