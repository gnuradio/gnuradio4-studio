{
  "format": "gr4-studio.graph",
  "version": 1,
  "metadata": {
    "name": "studio-blocks-sidebands.gr4s",
    "description": "A 1.4 kHz AM carrier, a pulsed 3.2 kHz interferer, and broadband noise. Compare the live trace with phosphor persistence.",
    "schedulerId": "gr::scheduler::SimpleMulti",
    "application": {
      "mode": "in_app",
      "renderer": "react",
      "title": "AM sidebands"
    },
    "studio": {
      "panels": [
        {
          "id": "controls",
          "kind": "control",
          "title": "Controls",
          "visible": true,
          "previewOnCanvas": false,
          "widgets": [
            {
              "id": "modulation-tone_frequency",
              "kind": "parameter",
              "binding": {
                "kind": "parameter",
                "nodeId": "modulation",
                "parameterName": "tone_frequency"
              },
              "label": "Modulation frequency (Hz)",
              "inputKind": "slider",
              "slider": {
                "min": 25,
                "max": 400,
                "step": 25
              },
              "mode": "immediate"
            },
            {
              "id": "interferer-tone_frequency",
              "kind": "parameter",
              "binding": {
                "kind": "parameter",
                "nodeId": "interferer",
                "parameterName": "tone_frequency"
              },
              "label": "Interferer frequency (Hz)",
              "inputKind": "slider",
              "slider": {
                "min": 2200,
                "max": 3800,
                "step": 50
              },
              "mode": "immediate"
            }
          ]
        },
        {
          "id": "spectrum",
          "nodeId": "spectrum",
          "kind": "series2d",
          "title": "AM sidebands",
          "visible": true,
          "previewOnCanvas": false,
          "plotStyle": {
            "assignmentMode": "byIndex",
            "palette": {
              "kind": "custom",
              "colors": [
                "#22d3ee",
                "#fb923c",
                "#a78bfa",
                "#4ade80"
              ]
            }
          }
        },
        {
          "id": "persistence",
          "nodeId": "persistence",
          "kind": "histogram",
          "title": "Interference persistence",
          "visible": true,
          "previewOnCanvas": false,
          "plotStyle": {
            "assignmentMode": "byIndex",
            "palette": {
              "kind": "custom",
              "colors": [
                "#22d3ee",
                "#fb923c",
                "#a78bfa",
                "#4ade80"
              ]
            }
          }
        },
        {
          "id": "time",
          "nodeId": "time",
          "kind": "series",
          "title": "AM waveform",
          "visible": true,
          "previewOnCanvas": false,
          "plotStyle": {
            "assignmentMode": "byIndex",
            "palette": {
              "kind": "custom",
              "colors": [
                "#22d3ee",
                "#fb923c",
                "#a78bfa",
                "#4ade80"
              ]
            }
          }
        }
      ],
      "variables": [
        {
          "id": "sample_rate",
          "name": "sample_rate",
          "binding": {
            "kind": "literal",
            "value": 8192
          }
        }
      ],
      "layout": {
        "version": 2,
        "root": {
          "kind": "split",
          "direction": "column",
          "children": [
            {
              "kind": "pane",
              "panelId": "controls"
            },
            {
              "kind": "split",
              "direction": "column",
              "children": [
                {
                  "kind": "split",
                  "direction": "row",
                  "children": [
                    {
                      "kind": "pane",
                      "panelId": "spectrum"
                    },
                    {
                      "kind": "pane",
                      "panelId": "persistence"
                    }
                  ]
                },
                {
                  "kind": "pane",
                  "panelId": "time"
                }
              ],
              "sizes": [
                72,
                28
              ]
            }
          ],
          "sizes": [
            18,
            82
          ]
        },
        "activePanelId": "controls"
      }
    }
  },
