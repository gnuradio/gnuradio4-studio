    "edges": [
      {
        "id": "clock-out-root-clk_in",
        "source": {
          "nodeId": "clock",
          "portId": "out"
        },
        "target": {
          "nodeId": "root",
          "portId": "clk_in"
        }
      },
      {
        "id": "clock-out-third-clk_in",
        "source": {
          "nodeId": "clock",
          "portId": "out"
        },
        "target": {
          "nodeId": "third",
          "portId": "clk_in"
        }
      },
      {
        "id": "clock-out-fifth-clk_in",
        "source": {
          "nodeId": "clock",
          "portId": "out"
        },
        "target": {
