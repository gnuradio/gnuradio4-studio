          }
        }
      },
      {
        "id": "mix",
        "blockType": "gr::blocks::math::Add<float32>",
        "title": "Three-tone mix",
        "executionMode": "active",
        "rotation": 0,
        "position": {
          "x": 550,
          "y": 150
        },
        "parameters": {
          "n_inputs": {
            "kind": "literal",
            "value": "3"
          }
        }
      },
      {
        "id": "spectrum",
        "blockType": "gr::studio::StudioPowerSpectrumSink<float32>",
        "title": "Chord spectrum",
        "executionMode": "active",
        "rotation": 0,
        "position": {
          "x": 850,
