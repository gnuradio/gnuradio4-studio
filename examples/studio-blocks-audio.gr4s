          },
          "phase": {
            "kind": "literal",
            "value": "0"
          },
          "seed": {
            "kind": "literal",
            "value": "0"
          }
        }
      },
      {
        "id": "third",
        "blockType": "gr::blocks::basic::SignalGenerator<float32>",
        "title": "Third",
        "executionMode": "active",
        "rotation": 0,
        "position": {
          "x": 260,
          "y": 200
        },
        "parameters": {
          "sample_rate": {
            "kind": "expression",
            "expr": "sample_rate"
          },
          "chunk_size": {
            "kind": "literal",
            "value": "256"
