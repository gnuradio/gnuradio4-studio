{
  "format": "gr4-studio.graph",
  "version": 1,
  "metadata": {
    "name": "studio-blocks-audio.gr4s",
    "description": "A quiet A-major chord at 440, 550, and 660 Hz with time and frequency views. Start playback in the audio panel.",
    "schedulerId": "gr::scheduler::SimpleMulti",
    "application": {
      "mode": "in_app",
      "renderer": "react",
      "title": "Three-tone audio"
    },
    "studio": {
      "panels": [
        {
          "id": "controls",
          "kind": "control",
          "title": "Controls",
          "visible": true,
          "previewOnCanvas": false,
          "widgets": [
            {
              "id": "third-tone_frequency",
              "kind": "parameter",
              "binding": {
                "kind": "parameter",
                "nodeId": "third",
                "parameterName": "tone_frequency"
              },
              "label": "Third (Hz)",
              "inputKind": "slider",
              "slider": {
                "min": 500,
                "max": 600,
                "step": 1
              },
              "mode": "immediate"
            },
            {
              "id": "fifth-tone_frequency",
              "kind": "parameter",
              "binding": {
                "kind": "parameter",
                "nodeId": "fifth",
                "parameterName": "tone_frequency"
              },
              "label": "Fifth (Hz)",
              "inputKind": "slider",
              "slider": {
                "min": 620,
                "max": 700,
                "step": 1
              },
              "mode": "immediate"
            }
          ]
        },
        {
          "id": "spectrum",
          "nodeId": "spectrum",
          "kind": "series2d",
          "title": "Chord spectrum",
          "visible": true,
          "previewOnCanvas": false,
          "plotStyle": {
            "assignmentMode": "byIndex",
            "palette": {
              "kind": "custom",
              "colors": [
                "#22d3ee",
                "#fb923c",
                "#a78bfa",
                "#4ade80"
              ]
            }
          }
        },
        {
          "id": "time",
          "nodeId": "time",
          "kind": "series",
          "title": "Chord waveform",
          "visible": true,
          "previewOnCanvas": false,
          "plotStyle": {
            "assignmentMode": "byIndex",
            "palette": {
              "kind": "custom",
              "colors": [
                "#22d3ee",
                "#fb923c",
                "#a78bfa",
                "#4ade80"
              ]
            }
          }
        },
        {
          "id": "audio",
          "nodeId": "audio",
          "kind": "audio",
          "title": "Playback",
          "visible": true,
          "previewOnCanvas": false,
          "plotStyle": {
            "assignmentMode": "byIndex",
            "palette": {
              "kind": "custom",
              "colors": [
                "#22d3ee",
                "#fb923c",
                "#a78bfa",
                "#4ade80"
              ]
            }
          }
        }
      ],
      "variables": [
        {
          "id": "sample_rate",
          "name": "sample_rate",
          "binding": {
            "kind": "literal",
            "value": 48000
          }
        }
      ],
      "layout": {
        "version": 2,
        "root": {
          "kind": "split",
          "direction": "column",
          "children": [
            {
              "kind": "pane",
              "panelId": "controls"
            },
            {
              "kind": "split",
              "direction": "column",
              "children": [
                {
                  "kind": "split",
                  "direction": "row",
                  "children": [
                    {
                      "kind": "pane",
                      "panelId": "time"
                    },
                    {
                      "kind": "pane",
                      "panelId": "spectrum"
                    }
                  ]
                },
                {
                  "kind": "pane",
                  "panelId": "audio"
                }
              ],
              "sizes": [
                78,
                22
              ]
            }
          ],
          "sizes": [
            18,
            82
          ]
        },
        "activePanelId": "controls"
      }
    }
  },
  "graph": {
    "nodes": [
      {
        "id": "clock",
        "blockType": "gr::blocks::basic::ClockSource",
        "title": "Sample clock",
        "executionMode": "active",
        "rotation": 0,
        "position": {
          "x": 0,
          "y": 0
        },
        "parameters": {
          "sample_rate": {
            "kind": "expression",
            "expr": "sample_rate"
          },
          "chunk_size": {
            "kind": "literal",
            "value": "256"
          },
          "n_samples_max": {
            "kind": "literal",
            "value": "0"
          }
        }
      },
      {
        "id": "root",
        "blockType": "gr::blocks::basic::SignalGenerator<float32>",
