          "binding": {
            "kind": "literal",
            "value": 75000
          }
        },
        {
          "id": "variable-4",
          "name": "deemphasis_tau",
          "binding": {
            "kind": "expression",
            "expr": "0.000075"
          }
        },
        {
          "id": "variable-5",
          "name": "resampler_num_filters",
          "binding": {
            "kind": "literal",
            "value": 32
          }
        },
        {
          "id": "variable-6",
          "name": "resampler_stop_band_attenuation",
          "binding": {
            "kind": "expression",
            "expr": "80.0"
          }
        },
        {
          "id": "variable-7",
          "name": "sdr_center_frequency",
          "binding": {
            "kind": "literal",
            "value": 99200000
          }
        },
        {
          "id": "variable-8",
          "name": "soapy_bandwidth",
          "binding": {
            "kind": "expression",
            "expr": "200000.0"
          }
        },
        {
          "id": "variable-9",
          "name": "soapy_gain",
          "binding": {
            "kind": "expression",
            "expr": "70.0"
          }
        },
        {
          "id": "variable-10",
          "name": "pi",
          "binding": {
            "kind": "expression",
            "expr": "3.141592653589793"
          }
        },
        {
          "id": "variable-11",
          "name": "quadrature_gain",
          "binding": {
            "kind": "expression",
            "expr": "quad_rate / (2 * pi * fm_max_deviation)"
          }
        },
        {
          "id": "variable-12",
          "name": "resampler_rate",
          "binding": {
            "kind": "expression",
            "expr": "audio_rate / quad_rate"
          }
        },
        {
          "id": "variable-13",
          "name": "station_freq",
          "binding": {
            "kind": "literal",
            "value": 99100000
          }
        },
        {
          "id": "variable-14",
          "name": "rotator_frequency_shift",
          "binding": {
            "kind": "expression",
            "expr": "sdr_center_frequency - station_freq"
          }
        },
        {
          "id": "variable-15",
          "name": "quad_rate",
          "binding": {
            "kind": "literal",
            "value": 400000
          }
        },
        {
          "id": "variable-16",
          "name": "decim",
          "binding": {
            "kind": "expression",
            "expr": "rf_sample_rate / quad_rate"
          }
        }
