{
  "format": "gr4-studio.graph",
  "version": 1,
  "metadata": {
    "name": "studio-blocks-waterfall.gr4s",
    "description": "Pulsed FM at −2.5 kHz with a 2–4 kHz noise band. Eight seconds of history; 32 Hz FFT bins.",
    "schedulerId": "gr::scheduler::SimpleMulti",
    "application": {
      "mode": "in_app",
      "renderer": "react",
      "title": "Burst waterfall"
    },
    "studio": {
      "panels": [
        {
          "id": "controls",
          "kind": "control",
          "title": "Controls",
          "visible": true,
          "previewOnCanvas": false,
          "widgets": [
            {
              "id": "burst_gate-tone_frequency",
              "kind": "parameter",
              "binding": {
                "kind": "parameter",
                "nodeId": "burst_gate",
                "parameterName": "tone_frequency"
              },
              "label": "Pulse rate (Hz)",
              "inputKind": "slider",
              "slider": {
                "min": 0.25,
                "max": 4,
                "step": 0.25
              },
              "mode": "immediate"
            },
            {
              "id": "band_noise-amplitude",
              "kind": "parameter",
              "binding": {
                "kind": "parameter",
                "nodeId": "band_noise",
                "parameterName": "amplitude"
              },
              "label": "Noise amplitude",
              "inputKind": "slider",
              "slider": {
                "min": 0,
                "max": 0.5,
                "step": 0.01
              },
              "mode": "immediate"
            }
          ]
        },
        {
          "id": "waterfall",
          "nodeId": "waterfall",
          "kind": "waterfall",
          "title": "Burst waterfall",
          "visible": true,
          "previewOnCanvas": false,
          "plotStyle": {
            "assignmentMode": "byIndex",
            "palette": {
              "kind": "custom",
              "colors": [
                "#22d3ee",
                "#fb923c",
                "#a78bfa",
                "#4ade80"
              ]
            }
          }
        },
        {
          "id": "spectrum",
          "nodeId": "spectrum",
          "kind": "series2d",
          "title": "Live spectrum",
          "visible": true,
          "previewOnCanvas": false,
          "plotStyle": {
            "assignmentMode": "byIndex",
            "palette": {
              "kind": "custom",
              "colors": [
                "#22d3ee",
                "#fb923c",
                "#a78bfa",
                "#4ade80"
              ]
            }
          }
        },
        {
          "id": "envelope",
          "nodeId": "envelope",
          "kind": "series",
          "title": "Burst envelope",
          "visible": true,
          "previewOnCanvas": false,
          "plotStyle": {
            "assignmentMode": "byIndex",
            "palette": {
              "kind": "custom",
              "colors": [
                "#fb923c",
                "#a78bfa",
                "#4ade80",
                "#22d3ee"
              ]
            }
          }
        }
      ],
      "variables": [
        {
          "id": "sample_rate",
          "name": "sample_rate",
          "binding": {
            "kind": "literal",
            "value": 16384
          }
        },
        {
          "id": "deviation_hz",
          "name": "deviation_hz",
          "binding": {
            "kind": "literal",
            "value": 1400
          }
        },
        {
          "id": "sweep_rate",
          "name": "sweep_rate",
          "binding": {
            "kind": "literal",
            "value": 0.2
          }
        }
      ],
      "layout": {
        "version": 2,
        "root": {
          "kind": "split",
          "direction": "column",
          "children": [
            {
              "kind": "pane",
              "panelId": "controls"
            },
            {
              "kind": "split",
              "direction": "row",
              "children": [
                {
                  "kind": "split",
                  "direction": "column",
                  "children": [
                    {
                      "kind": "pane",
                      "panelId": "spectrum"
                    },
                    {
                      "kind": "pane",
                      "panelId": "envelope"
                    }
                  ],
                  "sizes": [
                    65,
                    35
                  ]
                },
                {
                  "kind": "pane",
                  "panelId": "waterfall"
                }
              ],
              "sizes": [
                42,
                58
              ]
            }
          ],
          "sizes": [
            18,
            82
          ]
        },
        "activePanelId": "controls"
      }
    }
  },
  "graph": {
    "nodes": [
      {
        "id": "clock",
        "blockType": "gr::blocks::basic::ClockSource",
        "title": "Sample clock",
        "executionMode": "active",
        "rotation": 0,
        "position": {
          "x": 0,
          "y": 0
        },
        "parameters": {
          "sample_rate": {
            "kind": "expression",
            "expr": "sample_rate"
          },
          "chunk_size": {
            "kind": "literal",
            "value": "256"
          },
          "n_samples_max": {
            "kind": "literal",
            "value": "0"
          }
        }
      },
      {
        "id": "burst_gate",
        "blockType": "gr::blocks::basic::SignalGenerator<float32>",
        "title": "Burst gate",
        "executionMode": "active",
        "rotation": 0,
        "position": {
          "x": 260,
          "y": 0
        },
        "parameters": {
          "sample_rate": {
            "kind": "expression",
            "expr": "sample_rate"
          },
          "chunk_size": {
            "kind": "literal",
            "value": "256"
          },
          "signal_type": {
            "kind": "literal",
            "value": "Square"
          },
          "tone_frequency": {
            "kind": "literal",
            "value": "1.25"
          },
          "amplitude": {
            "kind": "literal",
            "value": "0.325"
          },
          "offset": {
            "kind": "literal",
            "value": "0.325"
          },
          "phase": {
            "kind": "literal",
            "value": "0"
          },
          "seed": {
            "kind": "literal",
            "value": "0"
          }
        }
      },
      {
        "id": "sweep_phase",
        "blockType": "gr::blocks::basic::SignalGenerator<float32>",
        "title": "Sweep phase",
        "executionMode": "active",
        "rotation": 0,
        "position": {
          "x": 260,
          "y": 180
        },
        "parameters": {
          "sample_rate": {
            "kind": "expression",
            "expr": "sample_rate"
          },
          "chunk_size": {
            "kind": "literal",
            "value": "256"
          },
          "signal_type": {
            "kind": "literal",
            "value": "Sin"
          },
          "tone_frequency": {
            "kind": "expression",
            "expr": "sweep_rate"
          },
          "amplitude": {
            "kind": "expression",
            "expr": "deviation_hz / sweep_rate"
          },
          "offset": {
            "kind": "literal",
            "value": "0"
          },
          "phase": {
            "kind": "literal",
            "value": "0"
          },
          "seed": {
            "kind": "literal",
            "value": "0"
          }
        }
      },
