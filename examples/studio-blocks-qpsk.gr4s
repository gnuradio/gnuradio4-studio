{
  "format": "gr4-studio.graph",
  "version": 1,
  "metadata": {
    "name": "studio-blocks-qpsk.gr4s",
    "description": "Pulse-shaped QPSK through carrier offset and Gaussian noise, followed by matched filtering, timing recovery, and carrier recovery.",
    "schedulerId": "gr::scheduler::SimpleMulti",
    "application": {
      "mode": "in_app",
      "renderer": "react",
      "title": "QPSK channel"
    },
    "studio": {
      "panels": [
        {
          "id": "controls",
          "kind": "control",
          "title": "Controls",
          "visible": true,
          "previewOnCanvas": false,
          "widgets": [
            {
              "id": "noise-noise_power",
              "kind": "parameter",
              "binding": {
                "kind": "parameter",
                "nodeId": "noise",
                "parameterName": "noise_power"
              },
              "label": "Noise power",
              "inputKind": "slider",
              "slider": {
                "min": 0,
                "max": 0.6,
                "step": 0.01
              },
              "mode": "immediate"
            },
            {
              "id": "carrier_offset-frequency_offset",
              "kind": "parameter",
              "binding": {
                "kind": "parameter",
                "nodeId": "carrier_offset",
                "parameterName": "frequency_offset"
              },
              "label": "Carrier offset (cycles/sample)",
              "inputKind": "slider",
              "slider": {
                "min": 0,
                "max": 0.002,
                "step": 0.00005
              },
              "mode": "immediate"
            }
          ]
        },
        {
          "id": "tx_xy",
          "nodeId": "tx_xy",
          "kind": "series2d",
          "title": "Transmitted symbols",
          "visible": true,
          "previewOnCanvas": false,
          "plotStyle": {
            "palette": {
              "kind": "custom",
              "colors": [
                "#22d3ee"
              ]
            }
          }
        },
        {
          "id": "rx_xy",
          "nodeId": "rx_xy",
          "kind": "series2d",
          "title": "Recovered symbols",
          "visible": true,
          "previewOnCanvas": false,
          "plotStyle": {
            "palette": {
              "kind": "custom",
              "colors": [
                "#a78bfa"
              ]
            }
          }
        },
        {
          "id": "spectrum",
          "nodeId": "spectrum",
          "kind": "series2d",
          "title": "Pulse-shaped spectrum",
          "visible": true,
          "previewOnCanvas": false,
          "plotStyle": {
            "assignmentMode": "byIndex",
            "palette": {
              "kind": "custom",
              "colors": [
                "#22d3ee",
                "#fb923c",
                "#a78bfa",
                "#4ade80"
              ]
            }
          }
        }
      ],
      "variables": [
        {
          "id": "sample_rate",
          "name": "sample_rate",
          "binding": {
            "kind": "literal",
            "value": 8192
          }
        },
        {
          "id": "samples_per_symbol",
          "name": "samples_per_symbol",
          "binding": {
            "kind": "literal",
            "value": 4
          }
        },
        {
          "id": "rolloff",
          "name": "rolloff",
          "binding": {
            "kind": "literal",
            "value": 0.35
          }
        },
        {
          "id": "symbol_count",
          "name": "symbol_count",
          "binding": {
            "kind": "literal",
            "value": 0
          }
        }
      ],
      "layout": {
        "version": 2,
        "root": {
          "kind": "split",
          "direction": "column",
          "children": [
            {
              "kind": "pane",
              "panelId": "controls"
            },
            {
              "kind": "split",
              "direction": "column",
              "children": [
                {
                  "kind": "split",
                  "direction": "row",
                  "children": [
                    {
                      "kind": "pane",
                      "panelId": "tx_xy"
                    },
                    {
                      "kind": "pane",
                      "panelId": "rx_xy"
                    }
                  ]
                },
                {
                  "kind": "pane",
                  "panelId": "spectrum"
                }
              ],
              "sizes": [
                68,
                32
              ]
            }
          ],
          "sizes": [
            18,
            82
          ]
        },
        "activePanelId": "controls"
      }
    }
  },
  "graph": {
    "nodes": [
      {
        "id": "symbols",
        "blockType": "gr::blocks::testing::CountingSource<uint8>",
        "title": "Symbol source",
        "executionMode": "active",
